{
    "compilerOptions": {
        "module": "esnext",
        "target": "esnext",
        "jsx": "react-jsx",
        "jsxImportSource": "preact",
        "moduleResolution": "bundler",
        "types": ["node", "vite/client"],
        "rootDir": ".",
        "noEmit": true,
        "esModuleInterop": true,
        "strict": true,
        "noImplicitAny": true,
        "forceConsistentCasingInFileNames": true,
        "noImplicitReturns": true,
        "paths": {
            "react": ["./node_modules/preact/compat/"]
        }
    },
    "include": ["src", "scripts"],
    "exclude": ["node_modules"]
}
